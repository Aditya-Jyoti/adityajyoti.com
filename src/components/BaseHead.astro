---
import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  /** Absolute or root-relative path to an LCP image to preload. */
  preloadImage?: string;
  /** Optional pre-generated WebP variant for the preload (same dimensions). */
  preloadImageWebp?: string;
  noindex?: boolean;
  /** Describes the image for social cards and screen readers. */
  imageAlt?: string;
  /** Trail of ancestors, closest last. The current page is appended for you. */
  breadcrumbs?: { name: string; href: string }[];
  /** Extra JSON-LD objects merged into the page's @graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/me-sketch.png",
  type = "website",
  pubDate,
  updatedDate,
  preloadImage,
  preloadImageWebp,
  noindex = false,
  imageAlt,
  breadcrumbs = [],
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).toString();

const fullTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;

const isArticle = type === "article";

const articleSchema = isArticle && pubDate
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      image: ogImage,
      author: {
        "@type": "Person",
        name: "Aditya Jyoti",
        url: "https://adityajyoti.in",
      },
      publisher: {
        "@type": "Person",
        name: "Aditya Jyoti",
        url: "https://adityajyoti.in",
      },
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      inLanguage: "en",
      isAccessibleForFree: true,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.toString(),
      },
    }
  : null;

// Breadcrumbs give Google the site hierarchy instead of a bare URL in results.
const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [...breadcrumbs, { name: title, href: Astro.url.pathname }].map(
          (crumb, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: crumb.name,
            item: new URL(crumb.href, Astro.site).toString(),
          })
        ),
      }
    : null;

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const schemas = [articleSchema, breadcrumbSchema, ...extraSchemas].filter(Boolean);

---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#fbf1c7" />

<!-- max-image-preview:large is what makes posts eligible for big image
     results and Google Discover; without it they get a thumbnail. -->
{
  noindex ? (
    <meta name="robots" content="noindex,nofollow" />
  ) : (
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
  )
}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content="Aditya Jyoti" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt ?? title} />
<meta property="og:locale" content="en_IN" />
{
  isArticle && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  isArticle && updatedDate && (
    <meta property="article:modified_time" content={updatedDate.toISOString()} />
  )
}
{isArticle && <meta property="article:author" content="Aditya Jyoti" />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta property="twitter:image:alt" content={imageAlt ?? title} />

<!-- Feeds -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} RSS Feed`}
  href={new URL("rss.xml", Astro.site)}
/>

<!-- Icon -->
<link rel="icon" type="image/png" href="/favicon.png" />

<!-- Fonts are self-hosted (see global.css). Preload only the two faces that
     are on screen immediately: the sketch font used for headings and nav, and
     the Latin upright Roboto used for body copy. -->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/Excalifont-Regular.woff2"
  crossorigin
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/roboto-normal-latin.woff2"
  crossorigin
/>

<!-- Preload LCP image so it's discoverable in HTML, not via CSS -->
{
  preloadImageWebp && (
    <link
      rel="preload"
      as="image"
      href={preloadImageWebp}
      type="image/webp"
      fetchpriority="high"
    />
  )
}
{
  !preloadImageWebp && preloadImage && (
    <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
  )
}

{
  schemas.map((entry) => (
    <script type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))
}

